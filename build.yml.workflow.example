name: Build Executables

on:
  push:
    branches: [ main, arena/* ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install flask pillow pyinstaller
      - name: Build Windows EXE
        run: |
          pyinstaller --name OldPhoneEmulator --onefile --console --add-data "emulator/ui/web/templates;emulator/ui/web/templates" --add-data "emulator/ui/web/static;emulator/ui/web/static" --hidden-import flask --hidden-import PIL --collect-all flask main.py
          dir dist
      - name: Upload Windows artifact
        uses: actions/upload-artifact@v4
        with:
          name: OldPhoneEmulator-Windows
          path: dist/OldPhoneEmulator.exe

  build-linux:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install flask pillow shiv
      - name: Build Linux binaries
        run: |
          mkdir -p /tmp/build
          cp -r emulator main.py /tmp/build/
          python -m zipapp /tmp/build -m "main:main" -o dist/OldPhoneEmulator.pyz -p "/usr/bin/env python3"
          cd /tmp/build && shiv --site-packages . -e main:main -o $GITHUB_WORKSPACE/dist/OldPhoneEmulator --compressed -p "/usr/bin/env python3"
          ls -lh dist/
      - name: Upload Linux artifact
        uses: actions/upload-artifact@v4
        with:
          name: OldPhoneEmulator-Linux
          path: |
            dist/OldPhoneEmulator
            dist/OldPhoneEmulator.pyz

  build-all-platforms:
    runs-on: ubuntu-latest
    needs: [build-windows, build-linux]
    steps:
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts
      - name: List artifacts
        run: ls -R artifacts
      - name: Create release bundle
        run: |
          mkdir -p release
          cp artifacts/OldPhoneEmulator-Windows/OldPhoneEmulator.exe release/ 2>/dev/null || echo "No Windows exe"
          cp artifacts/OldPhoneEmulator-Linux/OldPhoneEmulator release/ 2>/dev/null || echo "No Linux binary"
          cp artifacts/OldPhoneEmulator-Linux/OldPhoneEmulator.pyz release/ 2>/dev/null || echo "No pyz"
          ls -lh release/
      - name: Upload combined
        uses: actions/upload-artifact@v4
        with:
          name: OldPhoneEmulator-All
          path: release/
