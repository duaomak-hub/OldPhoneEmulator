# ROMs and large binaries (keep README)
roms/*.rom
roms/*.bin
roms/*.img
roms/*.rofs*
roms/*.uda
roms/*.fpsx
roms/*.iso
roms/*.vhd*
roms/*.qcow*
roms/*.vmdk
roms/*.sis*
roms/*.jar
!roms/README.md
# Keep demo files - allow small demo files
!roms/DemoApp.sisx
!roms/DemoMIDlet.jar
!roms/N95_ROFS2_demo.bin
!roms/demo_*.exe
!roms/demo_*.elf
!roms/demo_*.iso

# Emulated filesystem
fs/
.cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Build - keep spec ignored but allow dist executables
build/
*.spec
*.egg-info/
.eggs/

# Allow dist executables to be visible in repo!
!dist/
!dist/*.exe
!dist/*.pyz
!dist/*.bat
!dist/*.sh
!dist/*.txt
!dist/README.txt

# Venv
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
